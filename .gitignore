# Python
__pycache__/
*.pyc
.venv/
venv/
ov_env/
*.egg-info/
build/
dist/

# Model checkpoints
checkpoints/*.pth
checkpoints/*.safetensors
checkpoints/*.bin
!checkpoints/.gitkeep

# Data
# M10 Phase 1 (PoseNet training data, scripts/generate_posenet_data.py):
# ignore the bulk generated images/labels but keep dataset_meta.json tracked
# (sample count, seed, ranges, mujoco version, scene checksum -- the
# reproducibility record). Narrowed from a blanket `data/` (M01) to these two
# subdirectories specifically so dataset_meta.json is not swept up with them.
data/posenet/images/
data/posenet/labels/

# M15 (Speechmatics voice input, ADR-058): local WAV files used with
# `run_demo.py --voice` / `VoiceCommandSource` are not committed -- arbitrary
# size, no reproducibility value beyond the transcript the demo already
# prints, and (unlike the scene assets) not needed for anyone else to
# reproduce a text-driven run. The directory itself is kept via .gitkeep so
# `data/voice/` exists in a fresh clone for README's Voice Input usage.
data/voice/*.wav
!data/voice/.gitkeep
*.mp4
*.avi
# Exception: committed demo clip evidence (Fix B), small handful of MB,
# analogous to the docs/images/ render evidence already tracked.
!docs/videos/*.mp4

# Ad hoc probe/debug render output (scripts/probe_render.py); committed render
# evidence lives under docs/images/ instead, named per module.
out_probe.png
out/

# Hugging Face cache
.cache/

# Secrets
.env
*.pem
.kaggle

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Build artifacts (OpenVINO IR, reference tensors) -- regenerable, ~67MB
artifacts/
v2_demo_frames/
